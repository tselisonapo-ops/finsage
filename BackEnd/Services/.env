# ================================
# Environment
# ================================
APP_ENV=development
DEBUG=true
PORT=5000
RUN_BOOTSTRAP=true

# ================================
# Security and Database
# ================================
SECRET_KEY=replace-with-a-long-local-secret
JWT_SECRET_KEY=replace-with-another-long-local-secret

MASTER_DB_DSN=postgresql://postgres:N%40po1990@localhost:5432/moagiora_ifrs_master
DATABASE_URL=postgresql://postgres:N%40po1990@localhost:5432/moagiora_ifrs_master

# ================================
# Email Configuration
# Production SMTP may be unavailable
# ================================
MAIL_FROM=noreply@finspheresolutions.com
SMTP_HOST=
SMTP_PASS=
SMTP_PORT=465
SMTP_USER=
SMTP_USE_SSL=true
SMTP_USE_TLS=false

# ================================
# Frontend / Backend URLs
# ================================
FRONTEND_BASE=http://127.0.0.1:5500
BACKEND_BASE=http://127.0.0.1:5000
BASE_URL=http://127.0.0.1:5500/dashboard.html

FRONTEND_ORIGINS=http://127.0.0.1:5500,http://localhost:5500,http://127.0.0.1:5173,http://localhost:5173,http://127.0.0.1:3000,http://localhost:3000

# ================================
# Authentication
# ================================
AUTH_TOKEN_TTL=86400